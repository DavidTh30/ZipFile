        object cbHexSource: TComboBox
          Left = 6
          Height = 23
          Top = 6
          Width = 330
          ItemHeight = 15
          Items.Strings = (
            'Local file header + data (selected entry)'
            'Central directory record (selected entry)'
            'End of central directory (EOCD)'
