object frmDevInfo: TfrmDevInfo
  Left = 340
  Height = 640
  Top = 180
  Width = 1000
  Caption = 'BGRA Zip - Developer Information'
  ClientHeight = 640
  ClientWidth = 1000
  DesignTimePPI = 96
  Position = poDefaultPosOnly
  ShowInTaskBar = stAlways
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  object pcMain: TPageControl
    Left = 0
    Height = 600
    Top = 0
    Width = 1000
    ActivePage = tsOverview
    Align = alClient
    TabIndex = 0
    TabOrder = 0
    OnChange = pcMainChange
    object tsOverview: TTabSheet
      Caption = 'Overview'
      ClientHeight = 572
      ClientWidth = 992
      object lvOverview: TListView
        Left = 0
        Height = 572
        Top = 0
        Width = 992
        Align = alClient
        Columns = <
          item
            Caption = 'Property'
            Width = 260
          end
          item
            Caption = 'Value'
            Width = 700
          end>
        GridLines = True
        ReadOnly = True
        RowSelect = True
        TabOrder = 0
        ViewStyle = vsReport
      end
    end
    object tsEntries: TTabSheet
      Caption = 'Entries (raw)'
      ClientHeight = 572
      ClientWidth = 992
      object lvEntries: TListView
        Left = 0
        Height = 312
        Top = 0
        Width = 992
        Align = alClient
        Columns = <
          item
            Caption = '#'
            Width = 40
          end
          item
            Caption = 'Name'
            Width = 220
          end
          item
            Caption = 'Method'
            Width = 80
          end
          item
            Caption = 'Flags'
            Width = 60
          end
          item
            Caption = 'Made by'
            Width = 120
          end
          item
            Caption = 'Needs'
            Width = 50
          end
          item
            Caption = 'DOS date/time'
            Width = 130
          end
          item
            Caption = 'CRC32'
            Width = 75
          end
          item
            Alignment = taRightJustify
            Caption = 'Comp'
            Width = 80
          end
          item
            Alignment = taRightJustify
            Caption = 'Uncomp'
            Width = 80
          end
          item
            Alignment = taRightJustify
            Caption = 'Saved'
            Width = 55
          end
          item
            Alignment = taRightJustify
            Caption = 'LocalHdr@'
            Width = 80
          end
          item
            Alignment = taRightJustify
            Caption = 'Data@'
            Width = 80
          end
          item
            Alignment = taRightJustify
            Caption = 'Central@'
            Width = 80
          end
          item
            Caption = 'N/E/C len'
            Width = 70
          end
          item
            Caption = 'IntAttr'
            Width = 60
          end
          item
            Caption = 'ExtAttr'
            Width = 85
          end
          item
            Caption = 'Extra IDs'
            Width = 110
          end
          item
            Caption = 'Local'
            Width = 60
          end>
        GridLines = True
        HideSelection = False
        ReadOnly = True
        RowSelect = True
        TabOrder = 0
        ViewStyle = vsReport
        OnSelectItem = lvEntriesSelectItem
      end
      object splEntries: TSplitter
        Cursor = crVSplit
        Left = 0
        Height = 5
        Top = 312
        Width = 992
        Align = alBottom
        ResizeAnchor = akBottom
      end
      object memoEntry: TMemo
        Left = 0
        Height = 255
        Top = 317
        Width = 992
        Align = alBottom
        Font.Height = -12
        Font.Name = 'Consolas'
        ParentFont = False
        ReadOnly = True
        ScrollBars = ssBoth
        TabOrder = 1
        WordWrap = False
      end
    end
    object tsHex: TTabSheet
      Caption = 'Hex / Structure'
      ClientHeight = 572
      ClientWidth = 992
